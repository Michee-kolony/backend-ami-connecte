# Copier en .env et renseigner les valeurs (ne jamais committer le .env).
MONGODB_URI=mongodb://utilisateur:motdepasse@hote:27017/ami_connecte?authSource=ami-connecte
PORT=3000
# Adresse du tableau de bord (lien encodé dans le QR code de la carte patiente)
APP_URL=http://localhost:4200

# Authentification
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Durée de session de l'espace patiente (application mobile)
JWT_PATIENTE_EXPIRES_IN=30d
# Clé de chiffrement des discussions entre soignants (32 octets en base64 : openssl rand -base64 32)
CHAT_CLE=

# Cloudflare R2 (bucket privé pour les documents médicaux)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
